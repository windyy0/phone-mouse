# 本机配置模板：复制为 .env.local，按自己的环境取消注释并填写路径。
# Just 自动读取项目根目录的 .env.local；该本机文件不提交到 Git。

# Android 构建需要 JDK 17+ 和 Android SDK；已配置系统环境变量时可省略。
# Windows 路径可以使用 /，例如 D:/your-jdk；下面仅为占位示例。
# JAVA_HOME="/path/to/jdk"
# ANDROID_HOME="/path/to/android-sdk"

# Windows + JDK 18+：非 ASCII 项目路径导致测试类找不到时，可让 Gradle 使用系统原生编码。
# 英文路径和 macOS/Linux 通常无需此配置；JDK 17 请优先使用英文项目路径。
# GRADLE_OPTS='-Dorg.gradle.jvmargs="-Xmx2048m -Dfile.encoding=COMPAT"'

# 仅构建 Android Release 时需要：创建自己的密钥库和仓库外的签名配置。
# 配置内容见 README 的“从源码构建”；Debug APK 不需要正式签名。
# ANDROID_SIGNING_PROPERTIES="/path/to/signing.properties"
